# Copy to .env on the server (/opt/erp/.env), chmod 600. Never commit .env.

# Image built by GitHub Actions (erp-deploy/.github/workflows/build.yml)
CUSTOM_IMAGE=ghcr.io/vladimirfalkov/erp
CUSTOM_TAG=latest
PULL_POLICY=missing

# Site
SITE_NAME=erp.arvum.tech
LETSENCRYPT_EMAIL=

# MariaDB root password (long random string: openssl rand -base64 32)
DB_PASSWORD=
DB_BUFFER_POOL=768M

# Gunicorn (2 vCPU / 4 GB)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Local backups retention (days), used by scripts/backup.sh
BACKUP_KEEP_DAYS=7
